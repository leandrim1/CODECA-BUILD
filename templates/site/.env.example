# Endereco da plataforma.
CODECA_BASE_URL=https://codecabuild.vercel.app

# Chave PUBLICAVEL (cb_pub_...). Nao e segredo: le so conteudo publicado, e so
# a partir de uma origem cadastrada no painel da plataforma. Pode ir para o
# navegador, e por isso leva o prefixo `NEXT_PUBLIC_`.
NEXT_PUBLIC_CODECA_KEY=cb_pub_troque_isto

# Chave SECRETA (cb_sec_...). Le tambem rascunho. NUNCA com prefixo
# `NEXT_PUBLIC_`, nunca em componente de cliente, nunca no repositorio.
CODECA_SECRET_KEY=cb_sec_troque_isto

# Segredo do aviso de publicacao, para o site revalidar o cache sozinho.
# Aparece uma unica vez, ao cadastrar o endereco no painel mestre.
CODECA_WEBHOOK_SECRET=troque_isto

# Endereco da plataforma visto pelo navegador. Normalmente o mesmo valor de
# CODECA_BASE_URL. O banner de cookies o usa para ler a configuracao do site
# (controlador, politicas, ferramentas) e para enviar o registro da escolha.
NEXT_PUBLIC_CODECA_BASE_URL=https://codecabuild.vercel.app
