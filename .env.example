# ============================================================================
# Codeca Build - variaveis de ambiente
#
# ATENCAO: este arquivo e VERSIONADO e vai para o repositorio. Tudo que for
# escrito aqui fica publico no historico do Git, e apagar depois nao remove do
# historico -- a unica correcao real e trocar o segredo exposto.
#
# Ele contem somente nomes de variaveis e exemplos ficticios.
#
# Copie para `.env` e preencha os valores reais LA: esse e o arquivo lido pela
# aplicacao e pelos comandos de banco, e ele esta no `.gitignore`.
#
# Todas as variaveis sao lidas apenas no servidor: nenhuma delas chega ao
# navegador.
# ============================================================================

# ---------------------------------------------------------------- obrigatorias

# Conexao do Neon PostgreSQL. Use a string "pooled" do painel do Neon.
# Formato: postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/codeca?sslmode=require"

# Segredo usado para derivar os hashes dos tokens de sessao e dos IPs.
# Minimo de 32 caracteres. Gere com: openssl rand -base64 48
# Trocar este valor invalida todas as sessoes e todos os links de e-mail.
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres"

# ------------------------------------------------------------------- plataforma

# URL publica do painel. Usada nos links enviados por e-mail e na politica de CORS.
APP_URL="http://localhost:5173"

# Hosts que pertencem a plataforma e nunca resolvem para o site de um cliente.
# Separe por virgula. Aceita curinga no inicio (*.exemplo.com).
# O host de APP_URL e os deploys *.vercel.app ja entram automaticamente.
PLATFORM_HOSTS="localhost,app.localhost"

# Nome e endereco exibidos no selo "site criado com" dos planos que o mantem.
PLATFORM_NAME="Codeca Build"
PLATFORM_URL="https://codecabuild.com"

# --------------------------------------------------- armazenamento de arquivos

# Token do Vercel Blob (Storage > Blob > ".env.local" no painel da Vercel).
# Sem ele, a biblioteca de imagens informa que o envio esta indisponivel; o
# restante do painel continua funcionando.
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------- dominios

# Credenciais da API da Vercel, usadas para registrar e verificar os dominios
# dos clientes. Sem elas, os dominios ficam em "aguardando DNS" e nunca sao
# marcados como ativos automaticamente.
# Token: Vercel > Account Settings > Tokens (escopo do projeto).
VERCEL_API_TOKEN=""
# Id do projeto: Vercel > Project Settings > General > Project ID.
VERCEL_PROJECT_ID=""
# Informe apenas se o projeto pertence a um time.
VERCEL_TEAM_ID=""

# Alvos de DNS mostrados ao cliente nas instrucoes de dominio.
# Confira os valores atuais em Project Settings > Domains na Vercel.
DOMAIN_A_RECORD_IP="76.76.21.21"
DOMAIN_CNAME_TARGET="cname.vercel-dns.com"

# ----------------------------------------------------------- e-mail transacional

# Chave da Resend (https://resend.com). Sem a chave, os e-mails de confirmacao,
# redefinicao de senha e convite sao escritos no log do servidor com o link,
# o que serve para desenvolvimento mas nao para producao.
RESEND_API_KEY=""
MAIL_FROM="Codeca Build <nao-responda@seudominio.com.br>"

# ------------------------------------------------------------------- sessoes

# Duracao da sessao em horas; o segundo valor vale quando o usuario marca
# "manter conectado".
SESSION_TTL_HOURS="12"
SESSION_REMEMBER_TTL_HOURS="720"

# Exige HTTPS nos cookies. Em producao fica ligado automaticamente;
# defina "false" somente para desenvolvimento local em http.
COOKIE_SECURE="false"

# ------------------------------------------------------- pagamentos (ValidaPay)

# Credenciais OAuth2 criadas em app.validapay.com.br > Integracao > API.
# Nao e uma "API key": a integracao troca este par por um access_token.
# Escopos necessarios: products/read, products/write, checkouts/read,
# checkouts/write, subscriptions/read, subscriptions/write, charges/read.
# As credenciais sao por ambiente: uma de sandbox nao funciona em producao.
# Sem elas, a contratacao de planos e recusada com mensagem explicita.
VALIDAPAY_CLIENT_ID=""
VALIDAPAY_CLIENT_SECRET=""

# Segredo do webhook, definido ao cadastrar a URL em
# app.validapay.com.br > Integracao > Webhooks. E usado para validar a
# assinatura HMAC-SHA256 de cada evento. Sem ele, os webhooks sao recusados.
VALIDAPAY_WEBHOOK_SECRET=""

# Token estatico opcional do webhook (cabecalho x-access-token), se voce
# configurar um no cadastro. Barreira adicional, nunca substitui a assinatura.
VALIDAPAY_WEBHOOK_ACCESS_TOKEN=""

# Host da API. Producao: https://api.validapay.com.br
# Sandbox:           https://sandbox.validapay.com.br
VALIDAPAY_BASE_URL="https://sandbox.validapay.com.br"

# Host do OAuth2 -- e diferente do host da API.
# Producao: https://oauth2.validapay.com.br
# Sandbox:  https://oauth2-sandbox.validapay.com.br
# Deixe vazio para derivar automaticamente de VALIDAPAY_BASE_URL.
VALIDAPAY_AUTH_URL=""

# Janela de tolerancia do timestamp do webhook, em segundos.
VALIDAPAY_WEBHOOK_TOLERANCE_SECONDS="300"

# ------------------------------------------------------------------- cobranca

# Segredo exigido pelo job de reconciliacao (Authorization: Bearer <segredo>).
# Na Vercel, defina tambem CRON_SECRET com o mesmo valor: o Cron envia esse
# cabecalho automaticamente. Gere com: openssl rand -hex 32
BILLING_RECONCILIATION_SECRET=""

# Dias entre o vencimento de um pagamento e a suspensao do site. A tolerancia
# pode ser ajustada por empresa no painel mestre.
BILLING_GRACE_PERIOD_DAYS="5"

# ---------------------------------------------------------------- seed inicial

# Administrador da plataforma.
#
# Normalmente nao e preciso fazer nada: em uma instalacao nova, a PRIMEIRA
# conta cadastrada pela tela assume o painel mestre automaticamente. So a
# primeira -- as seguintes sao contas comuns.
#
# PLATFORM_ADMIN_EMAIL restringe quem pode assumir esse papel. Com ela
# definida, apenas esse endereco e promovido, mesmo que outra conta seja criada
# antes. Util quando a URL ja esta publica antes do seu cadastro. Guarda um
# e-mail, nunca uma senha -- e esta tambem e lida pelo servidor, portanto pode
# ser configurada no Vercel.
PLATFORM_ADMIN_EMAIL=""

# PLATFORM_ADMIN_PASSWORD e lida SOMENTE pelo `pnpm db:seed`, na maquina de
# quem o executa, para criar o administrador sem passar pela tela de cadastro.
# Nao configure no Vercel: a API nao a declara, e um segredo guardado ali sem
# uso e so risco. Preencha no seu `.env`, nunca neste arquivo.
PLATFORM_ADMIN_PASSWORD=""

# Cria uma construtora de demonstracao com conteudo publicado.
SEED_DEMO="false"
SEED_DEMO_EMAIL="demo@construtorahorizonte.com.br"
SEED_DEMO_PASSWORD=""
