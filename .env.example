# ============================================================================
# Codeca Build - variaveis de ambiente
#
# Copie este arquivo para `.env` e preencha com os seus valores.
# Todas as variaveis sao lidas apenas no servidor: nenhuma delas chega ao
# navegador. Nunca versione o arquivo `.env`.
# ============================================================================

# ---------------------------------------------------------------- obrigatorias

# Conexao do Neon PostgreSQL. Use a string "pooled" do painel do Neon.
# Formato: postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/codeca?sslmode=require"

# Segredo usado para derivar os hashes dos tokens de sessao e dos IPs.
# Minimo de 32 caracteres. Gere com: openssl rand -base64 48
# Trocar este valor invalida todas as sessoes e todos os links de e-mail.
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres"

# ------------------------------------------------------------------- plataforma

# URL publica do painel. Usada nos links enviados por e-mail e na politica de CORS.
APP_URL="http://localhost:5173"

# Hosts que pertencem a plataforma e nunca resolvem para o site de um cliente.
# Separe por virgula. Aceita curinga no inicio (*.exemplo.com).
# O host de APP_URL e os deploys *.vercel.app ja entram automaticamente.
PLATFORM_HOSTS="localhost,app.localhost"

# Nome e endereco exibidos no selo "site criado com" dos planos que o mantem.
PLATFORM_NAME="Codeca Build"
PLATFORM_URL="https://codecabuild.com"

# --------------------------------------------------- armazenamento de arquivos

# Token do Vercel Blob (Storage > Blob > ".env.local" no painel da Vercel).
# Sem ele, a biblioteca de imagens informa que o envio esta indisponivel; o
# restante do painel continua funcionando.
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------- dominios

# Credenciais da API da Vercel, usadas para registrar e verificar os dominios
# dos clientes. Sem elas, os dominios ficam em "aguardando DNS" e nunca sao
# marcados como ativos automaticamente.
# Token: Vercel > Account Settings > Tokens (escopo do projeto).
VERCEL_API_TOKEN=""
# Id do projeto: Vercel > Project Settings > General > Project ID.
VERCEL_PROJECT_ID=""
# Informe apenas se o projeto pertence a um time.
VERCEL_TEAM_ID=""

# Alvos de DNS mostrados ao cliente nas instrucoes de dominio.
# Confira os valores atuais em Project Settings > Domains na Vercel.
DOMAIN_A_RECORD_IP="76.76.21.21"
DOMAIN_CNAME_TARGET="cname.vercel-dns.com"

# ----------------------------------------------------------- e-mail transacional

# Chave da Resend (https://resend.com). Sem a chave, os e-mails de confirmacao,
# redefinicao de senha e convite sao escritos no log do servidor com o link,
# o que serve para desenvolvimento mas nao para producao.
RESEND_API_KEY=""
MAIL_FROM="Codeca Build <nao-responda@seudominio.com.br>"

# ------------------------------------------------------------------- sessoes

# Duracao da sessao em horas; o segundo valor vale quando o usuario marca
# "manter conectado".
SESSION_TTL_HOURS="12"
SESSION_REMEMBER_TTL_HOURS="720"

# Exige HTTPS nos cookies. Em producao fica ligado automaticamente;
# defina "false" somente para desenvolvimento local em http.
COOKIE_SECURE="false"

# ---------------------------------------------------------------- seed inicial

# Cria (ou confirma) o administrador da plataforma ao rodar `pnpm db:seed`.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""

# Cria uma construtora de demonstracao com conteudo publicado.
SEED_DEMO="false"
SEED_DEMO_EMAIL="demo@construtorahorizonte.com.br"
SEED_DEMO_PASSWORD=""
