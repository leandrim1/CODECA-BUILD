{
  "name": "codeca-build",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma SaaS multiempresa para sites de construtoras e incorporadoras",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @codeca/web dev",
    "build": "pnpm run build:packages && pnpm run db:deploy && pnpm --filter @codeca/web build",
    "build:packages": "pnpm --filter @codeca/shared --filter @codeca/sdk --filter @codeca/database --filter @codeca/ui --filter @codeca/api build",
    "typecheck": "pnpm run build:packages && tsc -p tsconfig.json && tsc -p tsconfig.contracts.json && pnpm --filter @codeca/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test",
    "db:generate": "pnpm --filter @codeca/database generate",
    "db:migrate": "pnpm --filter @codeca/database migrate",
    "db:seed": "pnpm --filter @codeca/database seed",
    "db:studio": "pnpm --filter @codeca/database studio",
    "clean": "rm -rf apps/*/dist packages/*/dist apps/web/.tsbuild && find . -name '*.tsbuildinfo' -not -path './node_modules/*' -delete",
    "db:deploy": "pnpm --filter @codeca/database run prepare-db",
    "sdk:check": "pnpm --filter @codeca/sdk build && node packages/sdk/scripts/prepublish.mjs --require-build",
    "sdk:pack": "pnpm --filter @codeca/sdk build && cd packages/sdk && pnpm publish --dry-run --no-git-checks"
  },
  "dependencies": {
    "@codeca/api": "workspace:*",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@codeca/sdk": "workspace:*",
    "@codeca/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.13",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver",
      "rolldown"
    ]
  }
}
